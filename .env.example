# ==========================================================================
# Tartila — contoh environment variables
# Salin file ini menjadi `.env` (atau `.env.local`) lalu isi nilainya.
#
# Catatan Vite:
# - Hanya variabel yang berawalan `VITE_` yang diekspos ke browser.
# - Semua nilai di-bundle saat build, jadi JANGAN simpan rahasia di sini.
# ==========================================================================

# Base URL REST API backend (tanpa trailing slash).
# Wajib kosong ("") agar request memakai URL relatif /api/... dan diteruskan
# oleh proxy Cloudflare (production) atau Vite (development), sehingga cookie
# tetap same-origin dan tidak diblokir browser.
VITE_API_BASE_URL=""

# Base URL WebSocket realtime (arena & duel), tanpa trailing slash.
# Awalan http:// otomatis diubah menjadi ws://, https:// menjadi wss://.
VITE_WS_URL=wss://ngaji-tartila.onrender.com

# DOKU Payment Gateway (Frontend)
# URL status pembayaran DOKU (return_url) yang dikirim backend saat generate checkout.
# Contoh: https://sambung-ngaji.github.io/tartila/
VITE_DOKU_RETURN_URL=

# Target proxy Vite dev server (default bila kosong: http://127.0.0.1:8080)
VITE_API_PROXY_TARGET=

# Supabase URL & Anon Key (untuk realtime game, arena multiplayer, dan classroom)
# Development (Docker local):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Production (Supabase Cloud):
#   VITE_SUPABASE_URL=https://your-project-ref.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-production-anon-key
# Supabase URL (Backend Go untuk JWKS & Frontend)
SUPABASE_URL=https://ukqzxxzdsesdqbamxxfb.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase JWT Secret (Backend Go: legacy fallback jika HMAC digunakan)
SUPABASE_JWT_SECRET=

# Google OAuth Client ID (tombol "Masuk dengan Google").
# Kosongkan bila login Google tidak dipakai.
# Contoh: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# (Opsional) Endpoint server multiplayer Colyseus untuk game Nur Battle.
# Kosongkan untuk memakai mode latihan offline.
# Contoh: wss://multiplayer.tartila.example.com
VITE_COLYSEUS_URL=

# (Opsional) URL model 3D pemain (.glb) di mode Battle.
# Default bila kosong: /models/ngaji-ceria/qirra.glb
# Contoh: https://cdn.tartila.example.com/models/qirra.glb
VITE_NGAJI_CERIA_PLAYER_MODEL=
