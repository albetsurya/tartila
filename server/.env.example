# ==============================================================================
# Tartila Backend Go - Environment Variables
# ==============================================================================

# Supabase JWT Secret (Didapat dari: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret)
# Digunakan untuk memvalidasi token Authorization: Bearer dari Supabase Auth
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# (Opsional) Fallback JWT Secret internal
JWT_SECRET=

# Port server (default: 8080)
PORT=8080

# CORS Allowed Origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tartila.example.com
