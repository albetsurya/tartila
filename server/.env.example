# ==============================================================================
# Tartila Backend Go - Environment Variables
# ==============================================================================

# Google OAuth Credentials (Goth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Frontend URL (untuk redirect setelah login OAuth)
FRONTEND_URL=https://tartila.pages.dev

# JWT Secret untuk menandatangani token HS256 HttpOnly Cookie
JWT_SECRET=your-strong-random-jwt-secret-here

# (Opsional) Session Secret untuk Gothic cookie store
SESSION_SECRET=your-session-secret-here

# Port server (default: 8080)
PORT=8080

# CORS Allowed Origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tartila.pages.dev
